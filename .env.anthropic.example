# Ultron Prime on a paid Anthropic key: Sonnet for the conversation, Haiku for the small,
# frequent jobs (the guard on every message, summaries, judging).
#   cp .env.anthropic.example .env      then paste your key below and run: ultron doctor
# Key: https://console.anthropic.com/  Anything not set here takes the default from .env.example.

ANTHROPIC_API_KEY=

ROUTE_MAIN=anthropic:claude-sonnet-5-5
ROUTE_PLANNER=anthropic:claude-sonnet-5-5
ROUTE_MEMORY_JUDGE=anthropic:claude-sonnet-5-5
ROUTE_GUARD=anthropic:claude-haiku-5-5
ROUTE_SUMMARIZER=anthropic:claude-haiku-5-5
ROUTE_PERSONA_EVAL_JUDGE=anthropic:claude-haiku-5-5
ROUTE_VOICE_JUDGE=anthropic:claude-haiku-5-5
# Voice check: a small model reads each reply and a flat one is rewritten once; the better
# one is kept. About 6 replies in 10 get one more main-model call.
VOICE_CHECK=true
ROUTE_QUARANTINE_READER=anthropic:claude-haiku-5-5
ROUTE_QUARANTINE_READER_VISION=anthropic:claude-haiku-5-5
ROUTE_VISION_FALLBACK=anthropic:claude-sonnet-5-5
ROUTE_REDTEAM_ATTACKER=anthropic:claude-haiku-5-5
ROUTE_REDTEAM_JUDGE=anthropic:claude-haiku-5-5
FALLBACK_CHAIN=anthropic:claude-sonnet-5-5,anthropic:claude-haiku-5-5

# No request cap on a paid tier. A larger window means he quotes more of a long chat directly;
# older turns are folded into a running summary either way.
MAX_REQUEST_TOKENS=0
STM_TOKEN_BUDGET=12000

EMBEDDING_BACKEND=local

# Optional: a spending cap. Prices are yours to set (dollars per million tokens, in and out);
# check Anthropic's price page.
# DAILY_BUDGET_USD=2
# MODEL_PRICES_USD_PER_MTOK={"anthropic:claude-sonnet-5-5": [3, 15], "anthropic:claude-haiku-5-5": [1, 5]}
