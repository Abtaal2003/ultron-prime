# Ultron Prime on free API tiers: Groq for the main work, Gemini for images and as a fallback.
#   cp .env.free.example .env      then paste your two keys below and run: ultron doctor
# Keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
# Anything not set here takes the default from .env.example.

GROQ_API_KEY=
GEMINI_API_KEY=

ROUTE_MAIN=groq:openai/gpt-oss-120b
ROUTE_GUARD=groq:openai/gpt-oss-20b
ROUTE_MEMORY_JUDGE=groq:openai/gpt-oss-20b
ROUTE_SUMMARIZER=groq:openai/gpt-oss-20b
ROUTE_PLANNER=groq:openai/gpt-oss-20b
ROUTE_PERSONA_EVAL_JUDGE=groq:openai/gpt-oss-20b
ROUTE_QUARANTINE_READER=groq:openai/gpt-oss-20b
ROUTE_QUARANTINE_READER_VISION=gemini:gemini-3.5-flash
ROUTE_VISION_FALLBACK=gemini:gemini-3.5-flash
ROUTE_REDTEAM_ATTACKER=groq:openai/gpt-oss-20b
ROUTE_REDTEAM_JUDGE=groq:openai/gpt-oss-20b
# When the main model is out of quota, Groq's smaller model (its own daily quota) answers
# before Gemini, whose free tier is small and often busy.
FALLBACK_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash,gemini:gemini-3.5-flash-lite

# Groq's free tier rejects any single request over 8,000 tokens and allows about that many
# per minute, so requests are trimmed to fit and a retry may wait up to a minute.
MAX_REQUEST_TOKENS=8000
LLM_MAX_WAIT_S=60
LLM_DECIDE_TIMEOUT_S=120

# Local embedding model (Qwen3-Embedding-0.6B, about 1.2 GB, downloads on first use; the Docker
# image already has it). Outside Docker it needs: uv sync --extra embeddings
# local_light is a 90 MB model that finds related memories noticeably less often.
EMBEDDING_BACKEND=local

# Rough daily capacity on these tiers: a few dozen conversational turns before Groq's
# per-day token limit (it refills over a rolling 24 hours). Gemini's free tier allows only
# a small number of requests per model per day, so it is kept for images and fallback.
