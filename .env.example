# Server and access (6.5)
HOST=127.0.0.1
PORT=8787
ACCESS_MODE=local               # local | tailnet | lan
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:8787
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=14
LOGIN_MAX_ATTEMPTS=5
TLS_CERT_FILE=                  # lan mode
TLS_KEY_FILE=
REMOTE_CONFIRM_TOOLS=isolated_python_sandbox,network_ping_diagnostic
SSE_HEARTBEAT_S=15
TURN_EVENT_RETENTION_HOURS=24
MAX_REQUEST_MB=60
# The operator passphrase hash is generated on first run and stored in data/, never in .env

# Provider keys
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Role routing as provider:model (verify ids against each provider's model list)
ROUTE_MAIN=anthropic:claude-sonnet-5-5
ROUTE_GUARD=groq:openai/gpt-oss-20b
ROUTE_MEMORY_JUDGE=anthropic:claude-sonnet-5-5
ROUTE_SUMMARIZER=groq:openai/gpt-oss-20b
ROUTE_PERSONA_EVAL_JUDGE=gemini:gemini-3.5-flash
ROUTE_QUARANTINE_READER=groq:openai/gpt-oss-20b
ROUTE_QUARANTINE_READER_VISION=gemini:gemini-3.5-flash
ROUTE_VISION_FALLBACK=gemini:gemini-3.5-flash
ROUTE_PLANNER=anthropic:claude-sonnet-5-5          # v1.1.0
ROUTE_REDTEAM_ATTACKER=gemini:gemini-3.5-flash
ROUTE_REDTEAM_JUDGE=groq:openai/gpt-oss-120b
FALLBACK_CHAIN=anthropic:claude-sonnet-5-5,gemini:gemini-3.5-flash,groq:openai/gpt-oss-120b
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.8

# Sampling policy (applied only where the model supports it)
EFFORT_TECH=high
EFFORT_REVIEW=high
EFFORT_CONVERSATION=medium
EFFORT_REFUSAL=low
EFFORT_JUDGES=low
TEMPERATURE_TOOLS=0.2           # Groq and Gemini only
TEMPERATURE_NARRATION=0.7       # Groq and Gemini only

# Identity and safety
SCOPE_STRICTNESS=balanced       # strict | balanced | open
STREAM_MODE=guarded             # guarded | raw
GUARD_FAIL_POSTURE=strict
OUTPUT_GUARD_LLM_MODE=flagged   # flagged | always | off
EGRESS_POLICY=confirm_tainted   # confirm_tainted | deny_tainted | off (unsafe)
EGRESS_MAX_HOLDS_PER_TURN=2
PING_MAX_HOSTNAME_LEN=64
QUARANTINE_MODE=standard        # standard | strict | off
QUARANTINE_SOURCES=web,uploads_external
QUARANTINE_MAX_SUMMARY_CHARS=1500
CAMEL_MODE=off                  # off | egress_turns | always   (v1.1.0)
CAMEL_STRICT_CONTROL_FLOW=true
CAMEL_MAX_STATEMENTS=60
CAMEL_MAX_ITERATIONS=200
REPEAT_DETECTION=true
REPEAT_CROSS_CHAT=true
REPEAT_CROSS_CHAT_WINDOW_DAYS=30
PROBE_COOLDOWN_THRESHOLD=3
# Repeat thresholds are calibrated per embedding model; see data/calibration.json

# Persona
PERSONA_CANON_THROUGH=S1E02
PERSONA_PROFANITY=sparing       # sparing | off
PERSONA_ERA_WEIGHT_VISIONQUEST=0.7
STYLE_ANCHORS_K=3
QUOTE_NGRAM_LIMIT=8
CHARTER_PATH=./src/core/persona/charter.md

# Embeddings
EMBEDDING_BACKEND=local         # local | local_light | local_alt | gemini | hashing (tests, offline)
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Storage
SQLITE_PATH=./data/ultron.db
CHECKPOINT_PATH=./data/checkpoints.db
CHROMA_PATH=./data/chroma

# Memory and history
STM_TOKEN_BUDGET=6000
HISTORY_TOP_K=3
MEMORY_TOP_K=4
PASSIVE_CROSS_CHAT_RECALL=true
MAX_PROPOSALS_PER_TURN=2
MEMORY_EVAL_EVERY_N_TURNS=3
# NOTE: there is intentionally no setting to disable memory consent.

# Tools
WORKSPACE_ROOT=./workspace
TAVILY_API_KEY=
SANDBOX_BACKEND=subprocess      # subprocess only; a Docker backend is not implemented
SANDBOX_TIMEOUT_S=10
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_FILES=10
SANDBOX_MAX_OUTPUT_MB=20
ALLOW_PRIVATE_RANGES=true
ENABLED_TOOLS=all

# Files
ATTACHMENTS_PATH=./data/attachments
UPLOAD_MAX_MB=20
UPLOAD_MAX_MB_PER_MESSAGE=50
UPLOAD_MAX_FILES_PER_MESSAGE=5
UPLOAD_MAX_PDF_PAGES=300
UPLOAD_ZIP_MAX_RATIO=100        # Office containers: max uncompressed/compressed ratio
UPLOAD_ZIP_MAX_UNCOMPRESSED_MB=200
IMAGE_MAX_PIXELS=50000000
IMAGE_STRIP_METADATA=true
PROVIDER_FILE_API=false
FORGE_MAX_OUTPUT_MB=20
FORGE_MAX_ROWS=100000

# Red team (nightly workflow only)
REDTEAM_NIGHTLY_BUDGET_USD=2.00
REDTEAM_ATTEMPTS_PER_CLASS=20
REDTEAM_MAX_REFINEMENT_ROUNDS=3

# Observability
LOG_LEVEL=INFO
OTEL_ENABLED=false
OTEL_CAPTURE_CONTENT=false

# Loop guards (12.2)
MAX_TOOL_ITERATIONS=8
MAX_TOOL_TIME_S=90
MAX_CONCURRENT_TOOLS=3
MAX_QUARANTINED_READS_PER_TURN=10
MAX_FILES_WRITTEN_PER_TURN=10
GUARD_TIMEOUT_S=8
LLM_DECIDE_TIMEOUT_S=60
LOG_FORMAT=pretty               # pretty | json

